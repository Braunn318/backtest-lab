{
  "name": "backtest-lab",
  "version": "0.5.1",
  "description": "Backtest Lab 0.5.1 – Diagnóza (kde ztrácím a kde vydělávám), Co kdyby (pravidla dne, cíl, SL), data a pokročilé analýzy z Futures Journal PRO, automatické aktualizace (read-only).",
  "main": "main.js",
  "private": true,
  "author": "Jája S",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cz.futuresjournal.backtestlab",
    "productName": "Backtest Lab",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Backtest Lab",
      "uninstallDisplayName": "Backtest Lab",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "artifactName": "Backtest-Lab-Setup-${version}.${ext}",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Braunn318",
        "repo": "backtest-lab"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
